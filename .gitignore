# .gitignore

# ============================================================
# WorldLoom — исключения Git
# ============================================================


# ------------------------------------------------------------
# Переменные окружения и локальные секреты
# ------------------------------------------------------------

.env
.env.*
!.env.example
!.env.sample
!.env.template

# Данные и секреты окружения Amvera
/data/

# Закрытые ключи и контейнеры сертификатов
*.key
*.p12
*.pfx
id_rsa
id_ed25519


# ------------------------------------------------------------
# Python — окружения и кэш
# ------------------------------------------------------------

.venv/
venv/
env/
ENV/
__pypackages__/

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/

# Отчёты о покрытии тестами
.coverage
.coverage.*
coverage.xml
htmlcov/

# Служебные результаты упаковки Python
*.egg-info/
.eggs/
/build/
/dist/


# ------------------------------------------------------------
# JavaScript / Node.js / Vite
# ------------------------------------------------------------

node_modules/
.vite/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Собранный фронтенд
/frontend/dist/

# Покрытие JavaScript-тестами
coverage/

# Отчёты браузерных тестов
playwright-report/
test-results/

# Диагностические журналы менеджеров пакетов
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ------------------------------------------------------------
# Пользовательские загрузки
# ------------------------------------------------------------

/frontend/uploads/


# ------------------------------------------------------------
# Логи и локальные базы данных
# ------------------------------------------------------------

/logs/
*.log
*.log.*

*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm


# ------------------------------------------------------------
# Результаты вспомогательных инструментов
# ------------------------------------------------------------

# Пакеты с содержимым исходников
/context_exports/
/docs/

# Автоматически построенные деревья проекта
/structure.txt
/project_structure.txt

# Локальная история и настройки Aider
.aider*

# Списки для инструментов намеренно НЕ исключены:
context_files.txt
structure_ignore.txt
vite_command.txt
requirements-dev.txt
check_deps.py

# ------------------------------------------------------------
# Редакторы и операционная система
# ------------------------------------------------------------

.idea/
.gigaide/
.vscode/

*.swp
*.swo
*~
*.iml

.DS_Store
._*
Thumbs.db
Desktop.ini

# Временные файлы
*.tmp
*.temp