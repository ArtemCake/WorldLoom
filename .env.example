# data/.env:

SECRET_KEY=СЕКРЕТНЫЙ_КЛЮЧ
ENCRYPTION_KEY=ВАШ_КЛЮЧ
EMAIL_HASH_KEY=ВАШ_КЛЮЧ

POSTGRES_USER=ВАШЕ_ИМЯ
POSTGRES_PASSWORD=ВАШ_ПАРОЛЬ
POSTGRES_HOST=ВАШ_ХОСТ
POSTGRES_PORT=ВАШ_ПОРТ
POSTGRES_DB=ВАШЕ_НАЗВАНИЕ_БД
BACKEND_CORS_ORIGINS=ВАШИ_АДРЕСА
ADMIN_PASSWORD=ВАШ_ПАРОЛЬ
ADMIN_EMAIL=ВАШ_АДРЕС_ПОЧТЫ
ADMIN_NICKNAME=ВАШ_НИКНЕЙМ
ENVIRONMENT=testing

# --- НАСТРОЙКИ ПОЧТОВОГО СЕРВЕРА ---
FRONTEND_URL=http://0.0.0.0:8080

SMTP_HOST=ВАШИ_НАСТРОЙКИ
SMTP_PORT=ВАШИ_НАСТРОЙКИ
SMTP_USE_TLS=false
SMTP_USE_SSL=true
SMTP_USER=ВАШИ_НАСТРОЙКИ
SMTP_PASSWORD=ВАШИ_НАСТРОЙКИ

SMTP_FALLBACK_HOST=ВАШИ_НАСТРОЙКИ
SMTP_FALLBACK_PORT=ВАШИ_НАСТРОЙКИ
SMTP_FALLBACK_USE_TLS=false
SMTP_FALLBACK_USE_SSL=true
SMTP_FALLBACK_USER=ВАШИ_НАСТРОЙКИ
SMTP_FALLBACK_PASSWORD=ВАШИ_НАСТРОЙКИ

MAIL_SENDER_NAME=ВАШИ_НАСТРОЙКИ
MAIL_SENDER_EMAIL=ВАШИ_НАСТРОЙКИ
MAIL_FALLBACK_SENDER_NAME=ВАШИ_НАСТРОЙКИ
MAIL_SUPPORT_EMAIL=ВАШИ_НАСТРОЙКИ

# ---- Настройка Блокировки -----
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_IP_RATE_LIMIT=20
LOGIN_IP_RATE_WINDOW_MINUTES=10
